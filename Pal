local BulletConfig = { Enabled = false, CheckShield = false, CheckFriend = false, ShootPart = "Head" }
local bulletTrackingHook = nil

local function hasShield(char)
    if not char then return false end
    if char:FindFirstChildOfClass("ForceField") then return true end
    for _, d in pairs(char:GetDescendants()) do
        if d.Name:lower():find("shield") then return true end
    end
    return false
end

local function isFriend(plr) return LocalPlayer:IsFriendsWith(plr.UserId) end

local function getBulletTarget()
    local target = nil
    local minDist = math.huge
    local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not myRoot then return nil end
    local whitelist = getWhitelist()
    local blacklist = getBlacklist()
    local blackMode = isBlackMode()
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and not table.find(whitelist, plr.UserId)
            and not (blackMode and not table.find(blacklist, plr.Name)) and plr.Character then
            local char = plr.Character
            local part = char:FindFirstChild(BulletConfig.ShootPart)
            local hum = char:FindFirstChildOfClass("Humanoid")
            if part and hum and hum.Health > 0 then
                if not (BulletConfig.CheckShield and hasShield(char))
                    and not (BulletConfig.CheckFriend and isFriend(plr)) then
                    local dist = (part.Position - myRoot.Position).Magnitude
                    if dist < minDist then
                        minDist = dist
                        target = part
                    end
                end
            end
        end
    end
    return target
end

local function installBulletHook()
    if bulletTrackingHook then
        hookmetamethod(game, "__namecall", bulletTrackingHook)
        bulletTrackingHook = nil
    end
    local orig
    orig = hookmetamethod(game, "__namecall", function(self, ...)
        local m = getnamecallmethod()
        local args = {...}
        if m == "Raycast" and not checkcaller() then
            local origin = args[1] or Camera.CFrame.Position
            local tar = getBulletTarget()
            if tar then
                return {
                    Instance = tar, Position = tar.Position,
                    Normal = (origin - tar.Position).Unit,
                    Material = Enum.Material.Plastic,
                    Distance = (tar.Position - origin).Magnitude
                }
            end
        end
        return orig(self, ...)
    end)
    bulletTrackingHook = orig
end

local function uninstallBulletHook()
    if bulletTrackingHook then
        hookmetamethod(game, "__namecall", bulletTrackingHook)
        bulletTrackingHook = nil
    end
end

local function setBulletTrack(v)
    BulletConfig.Enabled = v
    if v then installBulletHook() else uninstallBulletHook() end
end

getgenv().LapSetBulletTrack = setBulletTrack
getgenv().LapSetBulletShield = function(v) BulletConfig.CheckShield = v end
getgenv().LapSetBulletFriend = function(v) BulletConfig.CheckFriend = v end
