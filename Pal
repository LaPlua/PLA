local function tryPickItems(want)
    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return end
    local gameFolder = Workspace:FindFirstChild("Game")
    local entities = gameFolder and gameFolder:FindFirstChild("Entities")
    local itemPickup = entities and entities:FindFirstChild("ItemPickup")
    if not itemPickup then return end
    for _, l in pairs(itemPickup:GetChildren()) do
        for _, v in pairs(l:GetChildren()) do
            if v:IsA("MeshPart") or v:IsA("Part") then
                local prompt = v:FindFirstChildOfClass("ProximityPrompt")
                if prompt and prompt.ObjectText and want[prompt.ObjectText] then
                    root.CFrame = v.CFrame + Vector3.new(0, 2, 0)
                    prompt.RequiresLineOfSight = false
                    prompt.HoldDuration = 0
                    task.wait(0.05)
                    if fireproximityprompt then
                        fireproximityprompt(prompt)
                    else
                        firesignal(prompt.Triggered)
                    end
                end
            end
        end
    end
end

local function tryJewelryFarm(rareOnly)
    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return end
    local gameFolder = Workspace:FindFirstChild("Game")
    local entities = gameFolder and gameFolder:FindFirstChild("Entities")
    if not entities then return end


    local function trySafe(container)
        if not container then return end
        for _, safe in ipairs(container:GetChildren()) do
            if safe.PrimaryPart then
                root.CFrame = safe.PrimaryPart.CFrame + Vector3.new(0, 2, 0)
                local prompt = safe:FindFirstChild("ProximityPrompt", true)
                if prompt then
                    prompt.RequiresLineOfSight = false
                    prompt.HoldDuration = 0
                    task.wait(0.05)
                    if fireproximityprompt then fireproximityprompt(prompt) else firesignal(prompt.Triggered) end
                end
            end
        end
    end

    trySafe(entities:FindFirstChild("JewelSafe"))
    trySafe(entities:FindFirstChild("GoldJewelSafe"))

    if not rareOnly then
        local cases = entities:FindFirstChild("JewelryCase")
        if cases then
            for _, box in ipairs(cases:GetChildren()) do
                if box:FindFirstChild("ProximityPrompt") then
                    root.CFrame = box.CFrame + Vector3.new(0, 2, 0)
                    local prompt = box.ProximityPrompt
                    prompt.RequiresLineOfSight = false
                    prompt.HoldDuration = 0
                    task.wait(0.05)
                    if fireproximityprompt then fireproximityprompt(prompt) else firesignal(prompt.Triggered) end
                end
            end
        end
    end
end

local function tryEatPrinter(minMoney)
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return false end
    local cb = Workspace:FindFirstChild("Game")
    cb = cb and cb:FindFirstChild("Entities")
    cb = cb and cb:FindFirstChild("CashBundle")
    if not cb then return false end
    local originalCFrame = hrp.CFrame
    local found = false
    for _, l in ipairs(cb:GetChildren()) do
        local moneyValue = l:FindFirstChildWhichIsA("IntValue")
        if moneyValue and moneyValue.Value >= minMoney then
            local moneyPart = l:FindFirstChildWhichIsA("Part")
            if moneyPart then
                hrp.CFrame = moneyPart.CFrame
                task.wait(0.05)
                hrp.CFrame = originalCFrame
                found = true
                break
            end
        end
    end
    return found
end

task.spawn(function()
    while true do
        if autoPickEnabled then
            local want = buildWantSet()
            pcall(tryPickItems, want)
            if pickSubs.rareGemMoney or pickSubs.rareGemTeTraX then
                -- 已包含在 want 里，无需特别处理
            end
            if pickSubs.farmRareJew then pcall(tryJewelryFarm, true) end
            if pickSubs.farmAllJew then pcall(tryJewelryFarm, false) end
            if pickSubs.eatPrinter then pcall(tryEatPrinter, 1000) end
            if pickSubs.eatDaily then pcall(tryEatPrinter, 2000) end
        end
        task.wait(0.1)
    end
end)

