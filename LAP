    card.BorderSizePixel = 0
    card.ClipsDescendants = true
    card.ZIndex = 7
    card.Parent = page
    corner(card, cardRadius)
    makeStroke(card, theme.Border, 1, 0.4)

    local header = Instance.new("Frame")
    header.Size = UDim2.new(1, 0, 0, 56)
    header.BackgroundTransparency = 1
    header.ZIndex = 8
    header.Parent = card

    local titleLabel = Instance.new("TextButton")
    titleLabel.Size = UDim2.new(1, -76, 1, 0)
    titleLabel.Position = UDim2.new(0, 18, 0, 0)
    titleLabel.BackgroundTransparency = 1
    titleLabel.Text = sectionTitle
    titleLabel.TextColor3 = theme.Text
    titleLabel.TextSize = 13
    titleLabel.Font = Enum.Font.GothamSemibold
    titleLabel.TextXAlignment = Enum.TextXAlignment.Left
    titleLabel.AutoButtonColor = false
    titleLabel.Active = true
    titleLabel.ZIndex = 9
    titleLabel.Parent = header

    local plusBtn = Instance.new("TextButton")
    plusBtn.Size = UDim2.fromOffset(30, 30)
    plusBtn.Position = UDim2.new(1, -46, 0.5, 0)
    plusBtn.AnchorPoint = Vector2.new(0, 0.5)
    plusBtn.BackgroundTransparency = 1
    plusBtn.Text = "+"
    plusBtn.TextColor3 = theme.TextDim
    plusBtn.TextSize = 20
    plusBtn.Font = Enum.Font.GothamBold
    plusBtn.AutoButtonColor = false
    plusBtn.Active = true
    plusBtn.ZIndex = 10
    plusBtn.Parent = header

    local body = Instance.new("Frame")
    body.Size = UDim2.new(1, 0, 0, 0)
    body.Position = UDim2.new(0, 0, 0, 56)
    body.BackgroundTransparency = 1
    body.ClipsDescendants = true
    body.ZIndex = 8
    body.Parent = card

    local bodyLayout = Instance.new("UIListLayout")
    bodyLayout.Padding = UDim.new(0, 6)
    bodyLayout.SortOrder = Enum.SortOrder.LayoutOrder
    bodyLayout.Parent = body

    local bodyPadding = Instance.new("UIPadding")
    bodyPadding.PaddingTop = UDim.new(0, 4)
    bodyPadding.PaddingBottom = UDim.new(0, 14)
    bodyPadding.Parent = body

    local expanded = false
    local enabled = false

    plusBtn.MouseEnter:Connect(function()
        if not expanded then plusBtn.TextColor3 = theme.Text end
    end)
    plusBtn.MouseLeave:Connect(function()
        if not expanded then plusBtn.TextColor3 = theme.TextDim end
    end)

    card.MouseEnter:Connect(function()
        if not expanded then
            TweenService:Create(card, TweenInfo.new(0.15), {BackgroundColor3 = theme.CardHover}):Play()
        end
    end)
    card.MouseLeave:Connect(function()
        if not expanded then
            TweenService:Create(card, TweenInfo.new(0.15), {BackgroundColor3 = theme.Card}):Play()
        end
    end)

    local function recalc()
        if not expanded then return end
        task.wait(0.02)
        local h = bodyLayout.AbsoluteContentSize.Y + 18
        TweenService:Create(card, TweenInfo.new(0.22, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
            Size = UDim2.new(1, 0, 0, 56 + h)
        }):Play()
        TweenService:Create(body, TweenInfo.new(0.22, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
            Size = UDim2.new(1, 0, 0, h)
        }):Play()
    end

    local function setExpanded(v)
        if expanded == v then return end
        expanded = v
        if expanded then
            plusBtn.Text = "−"
            plusBtn.TextColor3 = theme.Accent
            local h = bodyLayout.AbsoluteContentSize.Y + 18
            TweenService:Create(card, TweenInfo.new(0.22, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                Size = UDim2.new(1, 0, 0, 56 + h)
            }):Play()
            TweenService:Create(body, TweenInfo.new(0.22, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                Size = UDim2.new(1, 0, 0, h)
            }):Play()
        else
            plusBtn.Text = "+"
            plusBtn.TextColor3 = theme.TextDim
            TweenService:Create(card, TweenInfo.new(0.22, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                Size = UDim2.new(1, 0, 0, 56)
            }):Play()
            TweenService:Create(body, TweenInfo.new(0.22, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                Size = UDim2.new(1, 0, 0, 0)
            }):Play()
        end
    end

    local toggleLock = 0
    plusBtn.MouseButton1Click:Connect(function()
        if tick() - toggleLock < 0.25 then return end
        toggleLock = tick()
        setExpanded(not expanded)
    end)

    titleLabel.MouseButton1Click:Connect(function()
        enabled = not enabled
        titleLabel.TextColor3 = enabled and theme.Accent or theme.Text
        if cfg.Callback then pcall(cfg.Callback, enabled) end
    end)

    local Section = {}
    Section.__body = body
    Section.__card = card
    Section.__theme = theme
    Section.__recalc = recalc
    Section.Expand = function(self, v) setExpanded(v ~= false) end
    Section.IsExpanded = function() return expanded end
    Section.SetEnabled = function(self, v)
        enabled = v and true or false
        titleLabel.TextColor3 = enabled and theme.Accent or theme.Text
        if cfg.Callback then pcall(cfg.Callback, enabled) end
    end
    Section.IsEnabled = function() return enabled end
    Section.GetBody = function() return body end
    Section.GetCard = function() return card end
    Section.Toggle = function(self, c) return addToggle(self, c) end
    Section.Button = function(self, c) return addButton(self, c) end
    Section.Dropdown = function(self, c) return addDropdown(self, c) end
    Section.Slider = function(self, c) return addSlider(self, c) end
    Section.Input = function(self, c) return addInput(self, c) end
    Section.Label = function(self, c) return addLabel(self, c) end
    Section.Divider = function(self) return addDivider(self) end

    if defaultOpen then setExpanded(true) end

    return Section
end

function MoonUI:CreateWindow(config)
    config = config or {}
    cleanupOld(config.Name or "MoonUI")

    local theme = merge({}, defaultTheme)
    if config.Theme then merge(theme, config.Theme) end

    local title = config.Title or "Moon"
    local subtitle = config.Subtitle or ""
    local tag = config.Tag or ""
    local size = config.Size or UDim2.fromOffset(700, 440)
    local sidebarWidth = config.SidebarWidth or 190
    local cardRadius = config.CardRadius or 12
    local tabRadius = config.TabRadius or 9

    local gui = mountGui(config.Name or "MoonUI")
    if not gui then
        warn("[MoonUI] 无法挂载 ScreenGui")
        return nil
    end

    local main = Instance.new("Frame")
    main.Name = "Main"
    main.Size = size
    main.Position = UDim2.new(0.5, 0, 0.5, 0)
    main.AnchorPoint = Vector2.new(0.5, 0.5)
    main.BackgroundColor3 = theme.Background
    main.BorderSizePixel = 0
    main.Active = false
    main.ZIndex = 5
    main.Parent = gui
    corner(main, 12)
    makeStroke(main, theme.Border, 1, 0)

    local mainScale = Instance.new("UIScale")
    mainScale.Scale = 1
    mainScale.Parent = main

    local pillCfg = config.Pill or {}
    local pill = nil
    local pillScale = nil

    if pillCfg.Enabled ~= false then
        pill = Instance.new("Frame")
        pill.Name = "Pill"
        pill.Size = UDim2.fromOffset(220, 40)
        pill.Position = UDim2.new(0.5, 0, 0, 20)
        pill.AnchorPoint = Vector2.new(0.5, 0)
        pill.BackgroundColor3 = theme.AccentDeep
        pill.BorderSizePixel = 0
        pill.Active = true
        pill.Visible = false
        pill.ZIndex = 10
        pill.Parent = gui
        corner(pill, 20)

        pillScale = Instance.new("UIScale")
        pillScale.Scale = 1
        pillScale.Parent = pill

        local pShadow = Instance.new("ImageLabel")
        pShadow.Size = UDim2.new(1, 20, 1, 20)
        pShadow.Position = UDim2.new(0, -10, 0, -3)
        pShadow.BackgroundTransparency = 1
        pShadow.Image = "rbxassetid://6014261993"
        pShadow.ImageColor3 = theme.PillShadow
        pShadow.ImageTransparency = 0.5
        pShadow.ScaleType = Enum.ScaleType.Slice
        pShadow.SliceCenter = Rect.new(49, 49, 450, 450)
        pShadow.ZIndex = 9
        pShadow.Parent = pill

        local pGrad = Instance.new("UIGradient")
        pGrad.Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0, theme.PillFrom),
            ColorSequenceKeypoint.new(0.5, theme.PillMid),
            ColorSequenceKeypoint.new(1, theme.PillTo),
        })
        pGrad.Parent = pill

        makeStroke(pill, theme.PillTo, 1, 0.5)

        local pText = Instance.new("TextLabel")
        pText.Size = UDim2.new(1, -20, 1, 0)
        pText.Position = UDim2.new(0, 10, 0, 0)
        pText.BackgroundTransparency = 1
        pText.Text = (pillCfg.Title or title) .. "  ·  FPS: 60  ·  Ping: 0"
        pText.TextColor3 = Color3.fromRGB(255, 255, 255)
        pText.TextSize = 13
        pText.Font = Enum.Font.GothamBold
        pText.TextStrokeTransparency = 1
        pText.ZIndex = 11
        pText.Parent = pill

        task.spawn(function()
            local frames = 0
            local last = tick()
            RunService.RenderStepped:Connect(function()
                frames = frames + 1
            end)
            while pill and pill.Parent do
                task.wait(1)
                local now = tick()
                local fps = math.floor(frames / (now - last))
                frames = 0
                last = now
                local ping = 0
                pcall(function() ping = math.floor(LocalPlayer:GetNetworkPing() * 1000) end)
                local str = pillCfg.Title or title
                if pillCfg.ShowFPS ~= false then str = str .. string.format("  ·  FPS: %d", fps) end
                if pillCfg.ShowPing ~= false then str = str .. string.format("  ·  Ping: %d", ping) end
                pcall(function() pText.Text = str end)
            end
        end)
    end

    local minBtn = Instance.new("TextButton")
    minBtn.Size = UDim2.fromOffset(30, 26)
    minBtn.Position = UDim2.new(1, -70, 0, 5)
    minBtn.BackgroundTransparency = 1
    minBtn.Text = "—"
    minBtn.TextColor3 = theme.TextDim
    minBtn.TextSize = 16
    minBtn.Font = Enum.Font.GothamBold
    minBtn.AutoButtonColor = false
    minBtn.ZIndex = 100
    minBtn.Parent = main

    local closeBtn = Instance.new("TextButton")
    closeBtn.Size = UDim2.fromOffset(30, 26)
    closeBtn.Position = UDim2.new(1, -38, 0, 5)
    closeBtn.BackgroundTransparency = 1
    closeBtn.Text = "×"
    closeBtn.TextColor3 = theme.TextDim
    closeBtn.TextSize = 18
    closeBtn.Font = Enum.Font.GothamBold
    closeBtn.AutoButtonColor = false
    closeBtn.ZIndex = 100
    closeBtn.Parent = main

    minBtn.MouseEnter:Connect(function() minBtn.TextColor3 = theme.Text end)
    minBtn.MouseLeave:Connect(function() minBtn.TextColor3 = theme.TextDim end)
    closeBtn.MouseEnter:Connect(function() closeBtn.TextColor3 = theme.Text end)
    closeBtn.MouseLeave:Connect(function() closeBtn.TextColor3 = theme.TextDim end)

    local function showMain()
        if main.Visible then return end
        main.Visible = true
        mainScale.Scale = 0
        TweenService:Create(mainScale, TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Scale = 1}):Play()
        if pill then
            TweenService:Create(pillScale, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {Scale = 0}):Play()
            task.delay(0.2, function()
                if pillScale and pillScale.Scale < 0.05 then
                    pill.Visible = false
                    pillScale.Scale = 1
                end
            end)
        end
    end

    local function showPill()
        if not pill then return end
        if pill.Visible then return end
        pill.Visible = true
        pillScale.Scale = 0
        TweenService:Create(pillScale, TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Scale = 1}):Play()
        TweenService:Create(mainScale, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {Scale = 0}):Play()
        task.delay(0.2, function()
            if mainScale.Scale < 0.05 then
                main.Visible = false
                mainScale.Scale = 1
            end
        end)
    end

    local lastMin = 0
    minBtn.MouseButton1Click:Connect(function()
        if tick() - lastMin < 0.4 then return end
        lastMin = tick()
        showPill()
    end)

    local lastClose = 0
    closeBtn.MouseButton1Click:Connect(function()
        if tick() - lastClose < 0.3 then return end
        lastClose = tick()
        gui.Enabled = false
    end)

    if pill then
        makeDraggable(pill, pill, showMain)
    end

    local sidebar = Instance.new("Frame")
    sidebar.Size = UDim2.new(0, sidebarWidth, 1, 0)
    sidebar.BackgroundTransparency = 1
    sidebar.ZIndex = 6
    sidebar.Parent = main

    local logoArea = Instance.new("Frame")
    logoArea.Size = UDim2.new(0, sidebarWidth, 0, 66)
    logoArea.BackgroundTransparency = 1
    logoArea.Active = true
    logoArea.ZIndex = 7
    logoArea.Parent = sidebar
    makeDraggable(main, logoArea)

    if title ~= "" then
        local logoText = Instance.new("TextLabel")
        logoText.Size = UDim2.new(1, -30, 0, 24)
        logoText.Position = UDim2.new(0, 18, 0, 18)
        logoText.BackgroundTransparency = 1
        logoText.Text = title
        logoText.TextColor3 = theme.Text
        logoText.TextSize = 19
        logoText.Font = Enum.Font.GothamBold
        logoText.TextXAlignment = Enum.TextXAlignment.Left
        logoText.ZIndex = 8
        logoText.Parent = logoArea

        if tag ~= "" then
            local logoTag = Instance.new("TextLabel")
            logoTag.Size = UDim2.fromOffset(26, 14)
            logoTag.Position = UDim2.new(0, 18 + (#title * 10 + 4), 0, 23)
            logoTag.BackgroundColor3 = theme.AccentDeep
            logoTag.Text = tag
            logoTag.TextColor3 = Color3.fromRGB(255, 255, 255)
            logoTag.TextSize = 9
            logoTag.Font = Enum.Font.GothamBold
            logoTag.ZIndex = 8
            logoTag.Parent = logoArea
            corner(logoTag, 4)
        end
    end

    if subtitle ~= "" then
        local logoSub = Instance.new("TextLabel")
        logoSub.Size = UDim2.new(1, -30, 0, 14)
        logoSub.Position = UDim2.new(0, 18, 0, 42)
        logoSub.BackgroundTransparency = 1
        logoSub.Text = subtitle
        logoSub.TextColor3 = theme.TextDim
        logoSub.TextSize = 10
        logoSub.Font = Enum.Font.GothamMedium
        logoSub.TextXAlignment = Enum.TextXAlignment.Left
        logoSub.ZIndex = 8
        logoSub.Parent = logoArea
    end

    local tabList = Instance.new("ScrollingFrame")
    tabList.Size = UDim2.new(1, -22, 1, -76)
    tabList.Position = UDim2.new(0, 11, 0, 70)
    tabList.BackgroundTransparency = 1
    tabList.BorderSizePixel = 0
    tabList.ScrollBarThickness = 2
    tabList.ScrollBarImageColor3 = theme.Border
    tabList.CanvasSize = UDim2.new(0, 0, 0, 520)
    tabList.ZIndex = 6
    tabList.Parent = sidebar

    local tabLayout = Instance.new("UIListLayout")
    tabLayout.Padding = UDim.new(0, 3)
    tabLayout.SortOrder = Enum.SortOrder.LayoutOrder
    tabLayout.Parent = tabList

    local content = Instance.new("Frame")
    content.Size = UDim2.new(1, -(sidebarWidth + 32), 1, -34)
    content.Position = UDim2.new(0, sidebarWidth + 16, 0, 20)
    content.BackgroundTransparency = 1
    content.ZIndex = 6
    content.Parent = main

    local contentScroll = Instance.new("ScrollingFrame")
    contentScroll.Size = UDim2.new(1, 0, 1, 0)
    contentScroll.BackgroundTransparency = 1
    contentScroll.BorderSizePixel = 0
    contentScroll.ScrollBarThickness = 3
    contentScroll.ScrollBarImageColor3 = theme.Border
    contentScroll.CanvasSize = UDim2.new(0, 0, 0, 2000)
    contentScroll.ZIndex = 6
    contentScroll.Parent = content

    local Window = {}
    Window.__gui = gui
    Window.__main = main
    Window.__pill = pill
    Window.__tabs = {}
    Window.__selectedTab = nil
    Window.__theme = theme
    Window.__cardRadius = cardRadius
    Window.__tabRadius = tabRadius

    function Window:GetGui() return gui end
    function Window:GetFrame() return main end
    function Window:Show() showMain() end
    function Window:Hide() showPill() end
    function Window:Toggle()
        if main.Visible then showPill() else showMain() end
    end
    function Window:Destroy() pcall(function() gui:Destroy() end) end
    function Window:GetTab(name)
        for _, t in ipairs(self.__tabs) do
            if t.name == name then return t end
        end
        return nil
    end

    if config.ToggleKey then
        UserInputService.InputBegan:Connect(function(input, gp)
            if gp then return end
            if input.KeyCode == config.ToggleKey then
                Window:Toggle()
            end
        end)
    end

    function Window:Tab(tabConfig)
        tabConfig = tabConfig or {}
        local tabName = tabConfig.Title or "Tab"

        local btn = Instance.new("TextButton")
        btn.Size = UDim2.new(1, 0, 0, 34)
        btn.BackgroundColor3 = theme.Background
        btn.BackgroundTransparency = 1
        btn.Text = ""
        btn.AutoButtonColor = false
        btn.Active = true
        btn.ZIndex = 7
        btn.Parent = tabList
        corner(btn, tabRadius)

        local label = Instance.new("TextLabel")
        label.Size = UDim2.new(1, -32, 1, 0)
        label.Position = UDim2.new(0, 16, 0, 0)
        label.BackgroundTransparency = 1
        label.Text = tabName
        label.TextColor3 = theme.TextDim
        label.TextSize = 12
        label.Font = Enum.Font.GothamMedium
        label.TextXAlignment = Enum.TextXAlignment.Left
        label.ZIndex = 8
        label.Parent = btn

        local page = Instance.new("Frame")
        page.Size = UDim2.new(1, 0, 0, 2000)
        page.BackgroundTransparency = 1
        page.Visible = false
        page.ZIndex = 7
        page.Parent = contentScroll

        local pageLayout = Instance.new("UIListLayout")
        pageLayout.Padding = UDim.new(0, 9)
        pageLayout.SortOrder = Enum.SortOrder.LayoutOrder
        pageLayout.Parent = page

        local tabData = {
            button = btn,
            label = label,
            page = page,
            name = tabName,
            theme = theme,
            cardRadius = cardRadius,
        }

        btn.MouseEnter:Connect(function()
            if Window.__selectedTab ~= tabData then
                btn.BackgroundColor3 = theme.Card
                btn.BackgroundTransparency = 0.4
            end
        end)
        btn.MouseLeave:Connect(function()
            if Window.__selectedTab ~= tabData then
                btn.BackgroundTransparency = 1
            end
        end)
        btn.MouseButton1Click:Connect(function()
            if Window.__selectedTab == tabData then return end
            if Window.__selectedTab then
                Window.__selectedTab.button.BackgroundTransparency = 1
                Window.__selectedTab.button.BackgroundColor3 = theme.Background
                Window.__selectedTab.label.TextColor3 = theme.TextDim
                Window.__selectedTab.page.Visible = false
            end
            Window.__selectedTab = tabData
            btn.BackgroundTransparency = 0
            btn.BackgroundColor3 = theme.AccentDeep
            label.TextColor3 = Color3.fromRGB(255, 255, 255)
            page.Visible = true
        end)

        function tabData:Section(cfg)
            return createSection(self, cfg)
        end

        function tabData:Select()
            btn.MouseButton1Click:Fire()
        end

        table.insert(Window.__tabs, tabData)

        if #Window.__tabs == 1 then
            Window.__selectedTab = tabData
            btn.BackgroundTransparency = 0
            btn.BackgroundColor3 = theme.AccentDeep
            label.TextColor3 = Color3.fromRGB(255, 255, 255)
            page.Visible = true
        end

        return tabData
    end

    return Window
end

getgenv().MoonUI = MoonUI
