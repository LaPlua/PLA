        if not expanded then
            TweenService:Create(card, TweenInfo.new(0.15), {BackgroundColor3 = theme.cardHover}):Play()
        end
    end)
    card.MouseLeave:Connect(function()
        if not expanded then
            TweenService:Create(card, TweenInfo.new(0.15), {BackgroundColor3 = theme.card}):Play()
        end
    end)

    local expandLock = 0
    expandBtn.MouseButton1Click:Connect(function()
        if tick() - expandLock < 0.25 then return end
        expandLock = tick()

        expanded = not expanded
        if expanded then
            expandBtn.Text = "−"
            expandBtn.TextColor3 = theme.accent
            local h = bodyLayout.AbsoluteContentSize.Y + 18
            TweenService:Create(card, TweenInfo.new(0.22, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                Size = UDim2.new(1, 0, 0, 56 + h)
            }):Play()
            TweenService:Create(body, TweenInfo.new(0.22, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                Size = UDim2.new(1, 0, 0, h)
            }):Play()
        else
            expandBtn.Text = "+"
            expandBtn.TextColor3 = theme.textDim
            TweenService:Create(card, TweenInfo.new(0.22, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                Size = UDim2.new(1, 0, 0, 56)
            }):Play()
            TweenService:Create(body, TweenInfo.new(0.22, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                Size = UDim2.new(1, 0, 0, 0)
            }):Play()
        end
    end)

    local toggleLock = 0
    titleBtn.MouseButton1Click:Connect(function()
        if tick() - toggleLock < 0.25 then return end
        toggleLock = tick()
        enabled = not enabled
        titleLabel.TextColor3 = enabled and theme.accent or theme.text
        if opts.onToggle then pcall(opts.onToggle, enabled) end
    end)

    local sectionObj = setmetatable({
        Window = self.Window,
        Card = card,
        Body = body,
        Title = titleLabel,
        Plus = expandBtn,
        Recalc = recalc,
        IsEnabled = function() return enabled end,
        SetEnabled = function(v)
            enabled = v
            titleLabel.TextColor3 = v and theme.accent or theme.text
            if opts.onToggle then pcall(opts.onToggle, v) end
        end,
    }, {__index = TabMeta})

    return sectionObj
end

