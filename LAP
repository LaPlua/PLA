function Window:Tab(name)
    local theme = self.Theme
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, 0, 0, 34)
    btn.BackgroundColor3 = theme.bg
    btn.BackgroundTransparency = 1
    btn.Text = ""
    btn.AutoButtonColor = false
    btn.Active = true
    btn.ZIndex = 7
    btn.Parent = self.TabList
    corner(btn, self.TabRadius)

    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, -32, 1, 0)
    label.Position = UDim2.new(0, 16, 0, 0)
    label.BackgroundTransparency = 1
    label.Text = name
    label.TextColor3 = theme.textDim
    label.TextSize = 12
    label.Font = Enum.Font.GothamMedium
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.ZIndex = 8
    label.Parent = btn

    local page = Instance.new("Frame")
    page.Size = UDim2.new(1, 0, 0, 2000)
    page.BackgroundTransparency = 1
    page.Visible = false
    page.ZIndex = 7
    page.Parent = self.ContentScroll

    local pageLayout = Instance.new("UIListLayout")
    pageLayout.Padding = UDim.new(0, 9)
    pageLayout.SortOrder = Enum.SortOrder.LayoutOrder
    pageLayout.Parent = page

    local tabObj = setmetatable({
        Window = self,
        Name = name,
        Button = btn,
        Label = label,
        Page = page,
        Layout = pageLayout,
    }, {__index = self.Tabs and getmetatable(self).__index or self})

    btn.MouseEnter:Connect(function()
        if self.SelectedTab ~= tabObj then
            btn.BackgroundColor3 = theme.card
            btn.BackgroundTransparency = 0.4
        end
    end)
    btn.MouseLeave:Connect(function()
        if self.SelectedTab ~= tabObj then
            btn.BackgroundTransparency = 1
        end
    end)
    btn.MouseButton1Click:Connect(function()
        if self.SelectedTab == tabObj then return end
        if self.SelectedTab then
            self.SelectedTab.Button.BackgroundTransparency = 1
            self.SelectedTab.Button.BackgroundColor3 = theme.bg
            self.SelectedTab.Label.TextColor3 = theme.textDim
            self.SelectedTab.Page.Visible = false
        end
        self.SelectedTab = tabObj
        btn.BackgroundTransparency = 0
        btn.BackgroundColor3 = theme.accentDeep
        label.TextColor3 = Color3.fromRGB(255, 255, 255)
        page.Visible = true
    end)

    table.insert(self.Tabs, tabObj)
    return tabObj
end

