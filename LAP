    lbl.TextColor3 = theme.text
    lbl.TextSize = 12
    lbl.Font = Enum.Font.GothamMedium
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.ZIndex = 9
    lbl.Parent = row

    local btn = Instance.new("TextButton")
    btn.Size = UDim2.fromOffset(130, 26)
    btn.Position = UDim2.new(1, 0, 0.5, 0)
    btn.AnchorPoint = Vector2.new(1, 0.5)
    btn.BackgroundColor3 = theme.inner
    btn.Text = "  " .. tostring(options[defaultIndex])
    btn.TextColor3 = theme.text
    btn.TextSize = 12
    btn.Font = Enum.Font.GothamMedium
    btn.TextXAlignment = Enum.TextXAlignment.Left
    btn.AutoButtonColor = false
    btn.ZIndex = 10
    btn.Active = true
    btn.Parent = row
    corner(btn, 6)

    local stroke = Instance.new("UIStroke")
    stroke.Color = theme.border
    stroke.Thickness = 1
    stroke.Parent = btn

    local arrow = Instance.new("TextLabel")
    arrow.Size = UDim2.fromOffset(18, 18)
    arrow.Position = UDim2.new(1, -14, 0.5, 0)
    arrow.AnchorPoint = Vector2.new(0.5, 0.5)
    arrow.BackgroundTransparency = 1
    arrow.Text = "▾"
    arrow.TextColor3 = theme.textDim
    arrow.TextSize = 13
    arrow.Font = Enum.Font.GothamBold
    arrow.ZIndex = 11
    arrow.Parent = btn

    local listFrame = Instance.new("Frame")
    listFrame.Size = UDim2.new(1, -32, 0, 0)
    listFrame.BackgroundColor3 = theme.inner
    listFrame.BorderSizePixel = 0
    listFrame.Visible = false
    listFrame.ZIndex = 12
    listFrame.Parent = self.Body
    corner(listFrame, 6)

    local listStroke = Instance.new("UIStroke")
    listStroke.Color = theme.border
    listStroke.Thickness = 1
    listStroke.Parent = listFrame

    local listLayout = Instance.new("UIListLayout")
    listLayout.Padding = UDim.new(0, 2)
    listLayout.SortOrder = Enum.SortOrder.LayoutOrder
    listLayout.Parent = listFrame

    local listPadding = Instance.new("UIPadding")
    listPadding.PaddingTop = UDim.new(0, 4)
    listPadding.PaddingBottom = UDim.new(0, 4)
    listPadding.Parent = listFrame

    local selectedIndex = defaultIndex

    for i, opt in ipairs(options) do
        local item = Instance.new("TextButton")
        item.Size = UDim2.new(1, -8, 0, 22)
        item.BackgroundTransparency = 1
        item.BackgroundColor3 = theme.accentDeep
        item.Text = "  " .. tostring(opt)
        item.TextColor3 = theme.text
        item.TextSize = 12
        item.Font = Enum.Font.GothamMedium
        item.TextXAlignment = Enum.TextXAlignment.Left
        item.AutoButtonColor = false
        item.ZIndex = 13
        item.LayoutOrder = i
        item.Parent = listFrame
        corner(item, 4)

        item.MouseEnter:Connect(function() item.BackgroundTransparency = 0.85 end)
        item.MouseLeave:Connect(function() item.BackgroundTransparency = 1 end)
        item.MouseButton1Click:Connect(function()
            selectedIndex = i
            btn.Text = "  " .. tostring(opt)
            listFrame.Visible = false
            arrow.Text = "▾"
            self.Recalc()
            if onChange then pcall(onChange, opt, i) end
        end)
    end

    local h = 8 + #options * 22 + (#options - 1) * 2
    listFrame.Size = UDim2.new(1, -32, 0, h)

    btn.MouseButton1Click:Connect(function()
        listFrame.Visible = not listFrame.Visible
        arrow.Text = listFrame.Visible and "▴" or "▾"
        self.Recalc()
    end)

    self.Recalc()
    return {
        Row = row,
        Button = btn,
        List = listFrame,
        GetValue = function() return options[selectedIndex], selectedIndex end,
        SetValue = function(i)
            if options[i] then
                selectedIndex = i
                btn.Text = "  " .. tostring(options[i])
                if onChange then pcall(onChange, options[i], i) end
            end
        end
    }
end

