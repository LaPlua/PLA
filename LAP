        d.TextColor3 = theme.TextDim
        d.TextSize = 11
        d.Font = Enum.Font.Gotham
        d.TextXAlignment = Enum.TextXAlignment.Left
        d.ZIndex = 9
        d.Parent = row
    end

    local switch = Instance.new("TextButton")
    switch.Size = UDim2.fromOffset(38, 20)
    switch.Position = UDim2.new(1, -6, 0.5, 0)
    switch.AnchorPoint = Vector2.new(1, 0.5)
    switch.BackgroundColor3 = theme.Track
    switch.Text = ""
    switch.AutoButtonColor = false
    switch.Active = true
    switch.ZIndex = 10
    switch.Parent = row
    corner(switch, 10)

    local knob = Instance.new("Frame")
    knob.Size = UDim2.fromOffset(16, 16)
    knob.Position = UDim2.new(0, 2, 0.5, 0)
    knob.AnchorPoint = Vector2.new(0, 0.5)
    knob.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    knob.BorderSizePixel = 0
    knob.ZIndex = 11
    knob.Parent = switch
    corner(knob, 8)

    local state = cfg.Value == true
    local function apply(v)
        state = v and true or false
        TweenService:Create(knob, TweenInfo.new(0.15), {
            Position = state and UDim2.new(1, -18, 0.5, 0) or UDim2.new(0, 2, 0.5, 0)
        }):Play()
        TweenService:Create(switch, TweenInfo.new(0.15), {
            BackgroundColor3 = state and theme.AccentDeep or theme.Track
        }):Play()
    end
    apply(state)

    local lock = 0
    switch.MouseButton1Click:Connect(function()
        if tick() - lock < 0.1 then return end
        lock = tick()
        apply(not state)
        if cfg.Callback then pcall(cfg.Callback, state) end
    end)

    section.__recalc()
    return {
        SetValue = function(v) apply(v) if cfg.Callback then pcall(cfg.Callback, state) end end,
        GetValue = function() return state end,
    }
end

