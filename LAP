    local arrow = Instance.new("TextLabel")
    arrow.Size = UDim2.fromOffset(18, 18)
    arrow.Position = UDim2.new(1, -14, 0.5, 0)
    arrow.AnchorPoint = Vector2.new(0.5, 0.5)
    arrow.BackgroundTransparency = 1
    arrow.Text = "▾"
    arrow.TextColor3 = theme.TextDim
    arrow.TextSize = 13
    arrow.Font = Enum.Font.GothamBold
    arrow.ZIndex = 11
    arrow.Parent = btn

    local listFrame = Instance.new("Frame")
    listFrame.Size = UDim2.new(1, -32, 0, 0)
    listFrame.BackgroundColor3 = theme.Inner
    listFrame.BorderSizePixel = 0
    listFrame.Visible = false
    listFrame.ZIndex = 12
    listFrame.Parent = body
    corner(listFrame, 6)
    makeStroke(listFrame, theme.Border, 1, 0)

    local listLayout = Instance.new("UIListLayout")
    listLayout.Padding = UDim.new(0, 2)
    listLayout.SortOrder = Enum.SortOrder.LayoutOrder
    listLayout.Parent = listFrame

    local listPadding = Instance.new("UIPadding")
    listPadding.PaddingTop = UDim.new(0, 4)
    listPadding.PaddingBottom = UDim.new(0, 4)
    listPadding.Parent = listFrame

    local selectedIndex = defaultIndex
    local selectedMulti = {}
    if multi and type(cfg.Value) == "table" then
        for _, v in ipairs(cfg.Value) do
            for i, opt in ipairs(options) do
                if opt == v then selectedMulti[i] = true end
            end
        end
    end

    for i, opt in ipairs(options) do
        local item = Instance.new("TextButton")
        item.Size = UDim2.new(1, -8, 0, 22)
        item.BackgroundTransparency = 1
        item.BackgroundColor3 = theme.AccentDeep
        item.Text = "  " .. tostring(opt)
        item.TextColor3 = theme.Text
        item.TextSize = 12
        item.Font = Enum.Font.GothamMedium
        item.TextXAlignment = Enum.TextXAlignment.Left
        item.AutoButtonColor = false
        item.Active = true
        item.ZIndex = 13
        item.LayoutOrder = i
        item.Parent = listFrame
        corner(item, 4)

        item.MouseEnter:Connect(function() item.BackgroundTransparency = 0.85 end)
        item.MouseLeave:Connect(function() item.BackgroundTransparency = 1 end)
        item.MouseButton1Click:Connect(function()
            if multi then
                selectedMulti[i] = not selectedMulti[i]
                local selected = {}
                for idx, v in ipairs(options) do
                    if selectedMulti[idx] then table.insert(selected, v) end
                end
                btn.Text = "  " .. (#selected == 0 and "None" or table.concat(selected, ", "))
                if cfg.Callback then pcall(cfg.Callback, selected) end
            else
                selectedIndex = i
                btn.Text = "  " .. tostring(opt)
                listFrame.Visible = false
                arrow.Text = "▾"
                if cfg.Callback then pcall(cfg.Callback, opt, i) end
            end
            section.__recalc()
        end)
    end

    local h = 8 + #options * 22 + (#options - 1) * 2
    listFrame.Size = UDim2.new(1, -32, 0, h)

    btn.MouseButton1Click:Connect(function()
        listFrame.Visible = not listFrame.Visible
        arrow.Text = listFrame.Visible and "▴" or "▾"
        section.__recalc()
    end)

    section.__recalc()
    return {
        Button = btn,
        List = listFrame,
        GetValue = function()
            if multi then
                local selected = {}
                for idx, v in ipairs(options) do
                    if selectedMulti[idx] then table.insert(selected, v) end
                end
                return selected
            end
            return options[selectedIndex], selectedIndex
        end,
        SetValue = function(v)
            if multi and type(v) == "table" then
                selectedMulti = {}
                for _, val in ipairs(v) do
                    for i, opt in ipairs(options) do
                        if opt == val then selectedMulti[i] = true end
                    end
                end
                local selected = {}
                for idx, opt in ipairs(options) do
                    if selectedMulti[idx] then table.insert(selected, opt) end
                end
                btn.Text = "  " .. (#selected == 0 and "None" or table.concat(selected, ", "))
                if cfg.Callback then pcall(cfg.Callback, selected) end
            else
                for i, opt in ipairs(options) do
                    if opt == v then
                        selectedIndex = i
                        btn.Text = "  " .. tostring(opt)
                        if cfg.Callback then pcall(cfg.Callback, opt, i) end
                        break
                    end
                end
            end
        end,
    }
end

local function addSlider(section, cfg)
    cfg = cfg or {}
    local theme = section.__theme
    local minV = cfg.Min or 0
    local maxV = cfg.Max or 100
    local defaultV = cfg.Value or minV
    local step = cfg.Step
    local row, lbl = makeRow(section, cfg.Title or "Slider", 28)

    local track = Instance.new("Frame")
    track.Size = UDim2.new(0.4, 0, 0, 4)
    track.Position = UDim2.new(0.5, 0, 0.5, 0)
    track.AnchorPoint = Vector2.new(0, 0.5)
    track.BackgroundColor3 = theme.Track
    track.BorderSizePixel = 0
    track.ZIndex = 9
    track.Parent = row
    corner(track, 2)

    local fill = Instance.new("Frame")
    fill.Size = UDim2.new(0, 0, 1, 0)
    fill.BackgroundColor3 = theme.AccentDeep
    fill.BorderSizePixel = 0
    fill.ZIndex = 10
    fill.Parent = track
    corner(fill, 2)

    local knob = Instance.new("Frame")
    knob.Size = UDim2.fromOffset(12, 12)
    knob.AnchorPoint = Vector2.new(0.5, 0.5)
    knob.BackgroundColor3 = theme.Accent
    knob.BorderSizePixel = 0
    knob.ZIndex = 11
    knob.Parent = track
    corner(knob, 6)

    local valueLbl = Instance.new("TextLabel")
    valueLbl.Size = UDim2.new(0, 55, 1, 0)
    valueLbl.Position = UDim2.new(1, 0, 0, 0)
    valueLbl.BackgroundTransparency = 1
    valueLbl.Text = tostring(defaultV)
    valueLbl.TextColor3 = theme.Text
    valueLbl.TextSize = 12
    valueLbl.Font = Enum.Font.GothamMedium
    valueLbl.TextXAlignment = Enum.TextXAlignment.Right
    valueLbl.ZIndex = 9
    valueLbl.Parent = row

    local value = defaultV
    local function setValue(v)
        v = math.clamp(v, minV, maxV)
        if step then v = math.floor(v / step + 0.5) * step end
        value = v
        local p = (v - minV) / (maxV - minV)
        fill.Size = UDim2.new(p, 0, 1, 0)
        knob.Position = UDim2.new(p, 0, 0.5, 0)
        valueLbl.Text = string.format("%.2f", v):gsub("%.?0+$", "")
        if cfg.Callback then pcall(cfg.Callback, v) end
    end
    setValue(defaultV)

    local dragging = false
    local function updateFromInput(input)
        local rel = (input.Position.X - track.AbsolutePosition.X) / track.AbsoluteSize.X
        setValue(minV + rel * (maxV - minV))
    end
    track.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            updateFromInput(input)
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            updateFromInput(input)
        end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)

    section.__recalc()
    return {
        SetValue = function(v) setValue(v) end,
        GetValue = function() return value end,
    }
end

