    local theme = section.__theme
    local body = section.__body
    local row = Instance.new("Frame")
    row.Size = UDim2.new(1, -32, 0, height or 28)
    row.BackgroundTransparency = 1
    row.ZIndex = 8
    row.Parent = body

    local lbl = Instance.new("TextLabel")
